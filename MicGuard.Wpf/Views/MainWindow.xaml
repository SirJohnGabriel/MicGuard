<Window x:Class="MicGuard.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MicGuard.Wpf.ViewModels"
        xmlns:local="clr-namespace:MicGuard.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="Mic Guard" Height="450" Width="800"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <Slider 
            Grid.Row="0" 
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Margin="105, 0, 105, 50"
            Maximum="100"
            SmallChange="1"
            Cursor="Hand"
            x:Name="VolumeSlider"
            ValueChanged="VolumeSlider_ValueChanged"
            PreviewMouseDown="VolumeSlider_PreviewMouseDown"
            PreviewMouseUp="VolumeSlider_PreviewMouseUp"
        />

        <Popup
            x:Name="VolumeSliderPopup"
            Placement="Top"
            AllowsTransparency="True"
            StaysOpen="True"
        >
            <Border x:Name="VolumeSliderPopupBorder" Background="Black" Padding="5" CornerRadius="5">
                <TextBlock x:Name="VolumeSliderPopupText" Foreground="White" />
            </Border>
        </Popup>

        <Button
            x:Name="EnableButton"
            Content="{Binding ButtonText}"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="120"
            Height="40"
            Command="{Binding ToggleEnabledCommand}"
            Cursor="Hand"
        />

        <CheckBox
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            ClipToBounds="True"
            Margin="15, 0, 0, 5"
            Content="Minimize to System Tray"
            Cursor="Hand"
            ToolTip="Clicking X minimizes Mic Guard instead of closing it completely."
        />

        <Label 
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            ClipToBounds="True"
            Margin="0, 0, 15, 5"
            Content="{Binding StatusText}"
            Foreground="{Binding StatusColor}"
        />
    </Grid>
</Window>
